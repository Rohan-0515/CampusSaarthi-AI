# ==============================================================================
# CampusSaarthi AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and substitute your actual Gemini API key below.
# NEVER commit the real '.env' file or paste your actual key in frontend code.
# ==============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Express Server Port (Default: 3000)
PORT=3000

# Optional: Gemini Model override (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash
